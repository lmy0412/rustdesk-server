# 生成方式：openssl rand -hex 32
RUSTDESK_JWT_SECRET=replace-with-at-least-32-random-characters
# 仅首次空库启动时需要；创建管理员后应删除。
RUSTDESK_INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password
RUSTDESK_API_BIND=127.0.0.1
# SQLite 使用单连接；切换 PostgreSQL 后可根据容量调大（例如 8）。
MAX_DATABASE_CONNECTIONS=1
RUST_LOG=info

# SQLite 默认模式保持为空。
RUSTDESK_DATABASE_URL=

# PostgreSQL 模式取消注释并使用同一个密码。
# POSTGRES_DB=rustdesk
# POSTGRES_USER=rustdesk
# POSTGRES_PASSWORD=replace-with-a-strong-password
# RUSTDESK_DATABASE_URL=postgresql://rustdesk:replace-with-a-url-encoded-password@postgres:5432/rustdesk
