[Unit]
Description=RustDesk Server Pro Relay 服务
Documentation=https://github.com/lmy0412/rustdesk-server/blob/dev/docs/pro-deployment.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=rustdesk
Group=rustdesk
EnvironmentFile=/etc/rustdesk-server/rustdesk.env
ExecStart=/usr/local/bin/hbbr --config /etc/rustdesk-server/config.toml
WorkingDirectory=/var/lib/rustdesk-server
StateDirectory=rustdesk-server
StateDirectoryMode=0750
RuntimeDirectory=rustdesk-server
RuntimeDirectoryMode=0750
UMask=0027
Restart=on-failure
RestartSec=5s
TimeoutStopSec=60s
LimitNOFILE=1048576
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
ReadWritePaths=/var/lib/rustdesk-server
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rustdesk-hbbr-pro

[Install]
WantedBy=multi-user.target
